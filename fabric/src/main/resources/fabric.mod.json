{
  "schemaVersion": 1,
  "id": "simplybows",
  "version": "${version}",
  "name": "Simply Bows Reforged",
  "description": "Six elemental bows, four runes, and upgradeable strings and frames. Simply Bows Reforged is a maintained fork of Simply Bows by Sweenus and Hootea.",
  "authors": [
    "Sweenus",
    "Hootea",
    "oNxZero"
  ],
  "contact": {
    "homepage": "https://github.com/oNxZero/simplybows",
    "sources": "https://github.com/oNxZero/simplybows",
    "issues": "https://github.com/oNxZero/simplybows/issues"
  },
  "license": "Timefall Development License 1.2",
  "icon": "assets/simplybows/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.sweenus.simplybows.fabric.SimplyBowsFabric"
    ],
    "client": [
      "net.sweenus.simplybows.fabric.client.SimplyBowsFabricClient"
    ]
  },
  "mixins": [
    "simplybows.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*",
    "simplytooltips": ">=0.1.4"
  }
}
